<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>dotnetdevmcp</AssemblyName>
    <RootNamespace>DotNetDevMCP.Server</RootNamespace>

    <!-- Ships as a .NET tool: `dotnet tool install -g DotNetDevMCP` or `dnx DotNetDevMCP` -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnetdevmcp</ToolCommandName>
    <PackageId>DotNetDevMCP</PackageId>
    <PackageType>McpServer</PackageType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon></PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include=".mcp\server.json" Pack="true" PackagePath="\.mcp\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotNetDevMCP.Analysis\DotNetDevMCP.Analysis.csproj" />
    <ProjectReference Include="..\DotNetDevMCP.Build\DotNetDevMCP.Build.csproj" />
    <ProjectReference Include="..\DotNetDevMCP.CodeIntelligence\DotNetDevMCP.CodeIntelligence.csproj" />
    <ProjectReference Include="..\DotNetDevMCP.Monitoring\DotNetDevMCP.Monitoring.csproj" />
    <ProjectReference Include="..\DotNetDevMCP.Orchestration\DotNetDevMCP.Orchestration.csproj" />
    <ProjectReference Include="..\DotNetDevMCP.SourceControl\DotNetDevMCP.SourceControl.csproj" />
    <ProjectReference Include="..\DotNetDevMCP.Testing\DotNetDevMCP.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Async" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

</Project>
