{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.csa7mdm/dotnetdevmcp",
  "description": "MCP server for .NET: Roslyn code navigation and refactoring, build, and affected-test selection.",
  "version": "0.3.0",
  "repository": {
    "url": "https://github.com/csa7mdm/DotNetDevMCP",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "nuget",
      "registryBaseUrl": "https://api.nuget.org/v3/index.json",
      "identifier": "DotNetDevMCP",
      "version": "0.3.0",
      "transport": { "type": "stdio" },
      "packageArguments": [
        {
          "type": "named",
          "name": "--load-solution",
          "description": "Path to a .sln to load on startup (optional)",
          "isRequired": false,
          "valueHint": "path/to/Solution.sln"
        }
      ]
    }
  ]
}
