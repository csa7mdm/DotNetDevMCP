<Project>
  <!--
    Own central-package-management file for tests/Sandbox.Fixtures, deliberately
    NOT inheriting the repo root's Directory.Packages.props (see the comment in
    the sibling Directory.Build.props for why). Versions below are copied from the
    root Directory.Packages.props "Testing" section and must be kept in sync with
    it by hand.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kept in sync with the root Directory.Packages.props "Testing" section. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
